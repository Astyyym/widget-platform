<Window x:Class="WpfShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget Platform G1-D" Width="292" Height="72"
        MinWidth="292" MinHeight="72" MaxWidth="380" MaxHeight="350"
        WindowStyle="None" ResizeMode="NoResize" ShowActivated="False"
        Background="#FFF7F5FA" KeyDown="OnWindowKeyDown">
    <Border x:Name="ShellBorder" Margin="4" Padding="0" Background="White"
            BorderBrush="#FFE5DFEF" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="SummaryRow" Grid.Row="0" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF7D58D4" Offset="0" />
                            <GradientStop Color="#FFB392F0" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="SYSTEM SAMPLE" Foreground="#FF777180" FontSize="9" FontWeight="Bold" />
                    <TextBlock Text="Ready · 23%" Foreground="#FF1D1A25" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
                <Button x:Name="OpenPanelButton" Grid.Column="4" MinWidth="54" Padding="10,7"
                        Content="Open" FontSize="11" FontWeight="SemiBold" Foreground="#FF4D337F"
                        Background="#FFF0EAFA" BorderThickness="0" Click="OnTogglePanel" />
            </Grid>
            <StackPanel x:Name="InputPanel" Grid.Row="1" Margin="12,2,12,10" Visibility="Collapsed">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Quick note" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" />
                    <Button Grid.Column="1" Width="24" Height="24" Content="×" FontSize="18"
                            Foreground="#FF4D337F" Background="#FFF0EAFA" BorderThickness="0"
                            Click="OnClosePanel" AutomationProperties.Name="Close input panel" />
                </Grid>
                <TextBlock Text="Display" Foreground="#FF777180" FontSize="10" FontWeight="SemiBold" />
                <ComboBox x:Name="DisplayBox" Height="28" Margin="0,3,0,4" FontSize="11"
                          SelectionChanged="OnDisplayChanged" />
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Along edge" Foreground="#FF777180" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="RatioLabel" Grid.Column="1" Text="50%" Foreground="#FF777180" FontSize="10" />
                </Grid>
                <Slider x:Name="RatioSlider" Minimum="0" Maximum="100" Value="50" Height="17"
                        Margin="0,0,0,2" Foreground="#FF8059CF" ValueChanged="OnRatioChanged" />
                <UniformGrid Rows="1" Columns="4" Margin="0,1,0,5">
                    <Button Content="Top" Tag="Top" Click="OnEdgeSelected" Margin="0,0,5,0" />
                    <Button Content="Right" Tag="Right" Click="OnEdgeSelected" Margin="0,0,5,0" />
                    <Button Content="Bottom" Tag="Bottom" Click="OnEdgeSelected" Margin="0,0,5,0" />
                    <Button Content="Left" Tag="Left" Click="OnEdgeSelected" />
                </UniformGrid>
                <TextBox x:Name="DraftInput" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                         FontSize="12" BorderBrush="#FFD9D1E7" BorderThickness="1"
                         TextChanged="OnDraftChanged" AutomationProperties.Name="Temporary note"
                         ToolTip="Type a temporary note" />
                <TextBlock x:Name="LocationStatus" Margin="1,5,1,0" Text="Position follows the selected display work area."
                           Foreground="#FF777180" FontSize="10" TextWrapping="Wrap" />
                <TextBlock Margin="1,3,1,0" Text="Tab moves between controls. Esc closes this panel and keeps the draft."
                           Foreground="#FF777180" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
