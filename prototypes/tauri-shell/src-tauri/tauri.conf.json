{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Widget Platform G1-B",
  "version": "0.1.0",
  "identifier": "dev.widget-platform.g1b",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Widget Platform G1-B",
        "width": 292,
        "height": 72,
        "minWidth": 292,
        "minHeight": 72,
        "maxWidth": 380,
        "maxHeight": 350,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": true,
        "focus": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}
