{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "widget-platform-g1a",
  "version": "0.1.0",
  "description": "Synthetic CPU summary and editable input interaction probe.",
  "tags": ["prototype", "synthetic-data"],
  "widgets": [
    {
      "name": "summary",
      "htmlPath": "./summary.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": false,
      "includeFiles": ["*.html", "*.js", "*.css"],
      "caching": {
        "defaultDuration": 0,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "18px",
          "width": "380px",
          "height": "60px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "input-panel",
      "htmlPath": "./input.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": false,
      "includeFiles": ["*.html", "*.js", "*.css"],
      "caching": {
        "defaultDuration": 0,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "94px",
          "width": "380px",
          "height": "150px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
